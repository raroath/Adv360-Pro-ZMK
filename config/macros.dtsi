macro_func_block: macro_func_block{
compatible = "zmk,behavior-macro";
label = "macro_func_block";
#binding-cells = <0>;
bindings = <&kp F>, <&kp U>, <&kp N>, <&kp C>, <&kp SPACE>, <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>, <&kp SPACE>, <&kp MINUS>, <&kp GREATER_THAN>, <&kp SPACE>, <&kp LEFT_BRACE>, <&kp RETURN>, <&kp UP>, <&kp RIGHT>, <&kp RIGHT>, <&kp RIGHT>, <&kp RIGHT>, <&kp RIGHT>;
};
macro_if_block: macro_if_block{
compatible = "zmk,behavior-macro";
label = "macro_if_block";
#binding-cells = <0>;
bindings = <&kp I>, <&kp F>, <&kp SPACE>, <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>, <&kp SPACE>, <&kp LEFT_BRACE>, <&kp RETURN>, <&kp UP>, <&kp RIGHT>, <&kp RIGHT>;
};
macro_quotes: macro_quotes{
compatible = "zmk,behavior-macro";
label = "macro_quotes";
#binding-cells = <0>;
bindings = <&kp SQT>, <&kp SQT>, <&kp LEFT>;
};
