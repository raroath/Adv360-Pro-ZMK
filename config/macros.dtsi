macro_func_block: macro_func_block{
compatible = "zmk,behavior-macro";
label = "macro_func_block";
#binding-cells = <0>;
bindings = <&kp F>, <&kp U>, <&kp N>, <&kp C>, <&kp SPACE>, <&kp SPACE>, <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>, <&kp SPACE>, <&kp MINUS>, <&kp GREATER_THAN>, <&kp SPACE>, <&kp LEFT_BRACE>, <&kp RETURN>, <&kp UP>, <&kp RIGHT>;
};
