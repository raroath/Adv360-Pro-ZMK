macro_dash_right: macro_dash_right{
compatible = "zmk,behavior-macro";
label = "macro_dash_right";
#binding-cells = <0>;
bindings = <&kp F>, <&kp F>;
};
macro_dash_left: macro_dash_left{
compatible = "zmk,behavior-macro";
label = "macro_dash_left";
#binding-cells = <0>;
bindings = <&kp A>, <&kp A>;
};
